{
  "name": "bweeep-launcher",
  "version": "0.1.27",
  "private": true,
  "description": "붸에엡 Minecraft modpack launcher",
  "author": "fri4666",
  "homepage": "https://github.com/fri4666/bweeep-launcher",
  "main": "dist/src/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-xmcl-compat.mjs",
    "prebuild": "node scripts/ensure-xmcl-compat.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && vite build",
    "package:portable": "npm run build && electron-packager . Bweeep --platform=win32 --arch=x64 --out=release --overwrite --asar --ignore=^/release --ignore=^/previews",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:win:test": "npm run build && electron-builder --win nsis --x64 --config build/electron-builder.test.js",
    "package:win:arm64": "npm run build && electron-builder --win nsis --arm64 --config.directories.output=release-installer-arm64",
    "package:win:all": "npm run package:win && npm run package:win:arm64",
    "verify:electron-startup": "npm run build && node scripts/verify-electron-startup.mjs",
    "verify:deep-link": "npm run build && node scripts/verify-deep-link.mjs",
    "verify:launch-identity": "npm run build && node scripts/verify-launch-identity.mjs",
    "verify:user-content": "npm run build && node scripts/verify-user-content.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@xmcl/core": "^2.16.2",
    "@xmcl/installer": "^6.3.3",
    "electron-updater": "6.8.9",
    "yauzl": "npm:@xmcl/yauzl@2.10.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "@xmcl/unzip": {
      ".": "2.1.0",
      "@xmcl/yauzl": "2.10.0"
    }
  },
  "build": {
    "appId": "com.fri4666.bweeep",
    "productName": "Bweeep",
    "directories": {
      "output": "release-installer"
    },
    "artifactName": "Bweeep-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "fri4666",
        "repo": "bweeep-launcher"
      }
    ],
    "asar": true,
    "icon": "build/icon-source-v2.png",
    "protocols": [
      {
        "name": "Bweeep Invite Link",
        "schemes": [
          "bwe-e-ep"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/@esbuild/**",
      "!node_modules/@types/**",
      "!node_modules/esbuild/**",
      "!node_modules/typescript/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/test{,s}/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/migrations/**"
    ],
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bweeep"
    }
  }
}
