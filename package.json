{
  "name": "bweeep-launcher",
  "version": "0.1.1",
  "private": true,
  "description": "붸에엡 Minecraft modpack launcher",
  "author": "fri4666",
  "homepage": "https://github.com/fri4666/bweeep-launcher",
  "main": "dist/src/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && vite build",
    "package:portable": "npm run build && electron-packager . Bweeep --platform=win32 --arch=x64 --out=release --overwrite --asar --ignore=^/release --ignore=^/previews",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@xmcl/core": "^2.16.1",
    "@xmcl/installer": "^6.3.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.63.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "@xmcl/unzip": {
      "@xmcl/yauzl": "2.10.0"
    }
  },
  "build": {
    "appId": "com.fri4666.bweeep",
    "productName": "Bweeep",
    "directories": {
      "output": "release-installer"
    },
    "artifactName": "Bweeep-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "**/*",
      "!release/**",
      "!release-installer/**",
      "!previews/**",
      "!create-aeronautics/**",
      "!supabase/**",
      "!scripts/**",
      "!src/**",
      "!.vscode/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bweeep"
    }
  }
}
